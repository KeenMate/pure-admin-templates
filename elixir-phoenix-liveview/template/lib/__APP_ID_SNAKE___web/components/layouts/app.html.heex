<.layout>
  <.navbar>
    <:start>
      <.navbar_burger />
      <.navbar_brand />
    </:start>
    <:center>
      <.navbar_title>
        <h2>{assigns[:page_title] || "Home"}</h2>
      </.navbar_title>
    </:center>
    <%!-- data-pa="profile-panel-component" --%>
    <:end_>
      <.navbar_profile_btn name="User" phx-click={toggle_profile_panel()} />
    </:end_>
    <%!-- /data-pa="profile-panel-component" --%>
  </.navbar>

  <.layout_inner>
    <.sidebar>
      <%!-- data-pa="sidebar-items" --%>
      <.sidebar_item label="Dashboard" icon="__ICON_DASHBOARD__" href="/" is_active={assigns[:current_path] == "/"} />
      <%!-- /data-pa="sidebar-items" --%>
    </.sidebar>

    <.layout_content>
      <.main>
        <.flash_group flash={@flash} />
        {@inner_content}
      </.main>
      <%!-- data-pa="footer-component" --%>
      <.footer />
      <%!-- /data-pa="footer-component" --%>
    </.layout_content>
  </.layout_inner>
</.layout>

<%!-- data-pa="settings-panel-component" --%>
<.settings_panel default_theme="__DEFAULT_THEME__" />
<%!-- /data-pa="settings-panel-component" --%>

<%!-- data-pa="profile-panel-component" --%>
<.profile_panel id="profile-panel" name="User" email="user@example.com" role="User">
  <div class="pa-tabs__panel pa-tabs__panel--active" data-profile-panel="profile">
    <nav class="pa-profile-panel__nav">
      <ul>
__PROFILE_ITEMS__
      </ul>
    </nav>
  </div>

  <:footer_>
    <button class="pa-btn pa-btn--danger pa-btn--block">
      __ICON:right-from-bracket__ Sign Out
    </button>
  </:footer_>
</.profile_panel>
<%!-- /data-pa="profile-panel-component" --%>

<.toast_container id="toasts" position="top-end" is_hook />
