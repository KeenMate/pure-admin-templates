{
  "$schema": "../schemas/pure-admin-template.schema.json",
  "id": "elixir-phoenix-liveview",
  "name": "Phoenix LiveView + Pure Admin",
  "version": "1.0.0",
  "technology": "elixir",
  "variant": "phoenix-liveview",
  "description": "Phoenix LiveView app with Pure Admin layout, sidebar navigation, and theme switching",
  "content": "## Phoenix LiveView + Pure Admin\n\nA Phoenix LiveView application template with Pure Admin layout, sidebar navigation, theme switching, and optional panels.\n\n### Highlights\n\n- **Phoenix LiveView** with the standard `mix phx.new` scaffold\n- **keen_pure_admin** as a drop-in replacement for `CoreComponents`\n- **Pure Admin** layout (navbar, sidebar, footer) read from app config\n- **Theme switching** via pureadmin.io themes\n- **Optional features**: Ecto, mailer, dashboard, gettext, profile panel, settings panel\n- **Page generators**: dashboard, list, detail, form, master-detail (each is a Phoenix LiveView module + heex template)\n\n### Quick Start\n\n```bash\npureadmin create my-app --template elixir-phoenix-liveview\ncd my-app\nmix ecto.create  # if ecto is enabled\nmix phx.server\n```",
  "author": "KeenMate",
  "license": "MIT",
  "tags": [
    "elixir",
    "phoenix",
    "liveview",
    "ssr",
    "fullstack"
  ],
  "homepage": "https://pureadmin.io",
  "scaffold": {
    "command": "mix phx.new __APP_ID__ --app __APP_ID_SNAKE__ --module __APP_MODULE__ --no-tailwind __SCAFFOLD_FLAGS__ --install",
    "fallback": "mix phx.new __APP_ID__ --app __APP_ID_SNAKE__ --module __APP_MODULE__ --no-tailwind __SCAFFOLD_FLAGS__",
    "runFirst": true
  },
  "themeSetup": {
    "themesDir": "priv/static/themes"
  },
  "placeholders": {
    "APP_NAME": {
      "description": "Display name shown in navbar and footer",
      "default": "My App"
    },
    "APP_ID": {
      "description": "Elixir application name (snake_case, used as :app and module prefix)",
      "default": "my_app"
    },
    "APP_MODULE": {
      "description": "Elixir module name (PascalCase, e.g. MyApp)",
      "default": "MyApp"
    },
    "COPYRIGHT": {
      "description": "Footer copyright text",
      "default": "© 2026 My Company"
    },
    "DEFAULT_THEME": {
      "description": "Default theme slug",
      "default": "audi"
    },
    "DEFAULT_MODE": {
      "description": "Default color mode (dark/light)",
      "default": "dark"
    }
  },
  "features": {
    "ecto": {
      "description": "Ecto database integration (Postgres by default)",
      "isDefault": true,
      "points": [
        "ecto-config"
      ],
      "cli": "--no-ecto",
      "scaffoldFlag": "--no-ecto"
    },
    "mailer": {
      "description": "Swoosh mailer for sending emails",
      "isDefault": true,
      "points": [],
      "cli": "--no-mailer",
      "scaffoldFlag": "--no-mailer"
    },
    "dashboard": {
      "description": "Phoenix LiveDashboard at /dev/dashboard",
      "isDefault": true,
      "points": [],
      "cli": "--no-dashboard",
      "scaffoldFlag": "--no-dashboard"
    },
    "gettext": {
      "description": "Gettext for i18n (required — template uses gettext() in app.html.heex / home.html.heex / dashboard_live.ex and routes keen_pure_admin's pureAdmin.* keys through Gettext.dgettext under the \"pure_admin\" domain)",
      "isRequired": true,
      "points": []
    },
    "navbar": {
      "description": "Top navigation bar with burger menu",
      "isRequired": true,
      "points": [
        "navbar-component"
      ]
    },
    "sidebar": {
      "description": "Side navigation with menu items",
      "isRequired": true,
      "points": [
        "sidebar-component"
      ]
    },
    "demo-pages": {
      "description": "Demo Users + Settings LiveViews (sidebar entries + routes + LiveView modules). Pass --bare to skip and start with just / and /getting-started.",
      "isDefault": true,
      "cliDisable": "--bare",
      "points": [
        "demo-pages-sidebar"
      ]
    },
    "form-demo": {
      "description": "Phoenix/LiveView form demo with per-session ETS cache (FormCache + Sweeper + SessionPlug + FormDemoLive). Showcases <.simple_form> + field={@form[:x]} binding, inline edit, toast+undo delete, popconfirm bulk clear, relative timestamps via PureAdmin.DateTime.",
      "cli": "--form-demo",
      "points": [
        "form-demo-sidebar"
      ]
    },
    "footer": {
      "description": "Page footer with copyright",
      "isRequired": true,
      "points": [
        "footer-component"
      ]
    },
    "profile-panel": {
      "description": "User profile slide-in panel",
      "requires": [
        "navbar"
      ],
      "points": [
        "profile-panel-component"
      ],
      "cli": "--profile-panel"
    },
    "settings-panel": {
      "description": "Theme switcher and display settings gear",
      "points": [
        "settings-panel-component"
      ],
      "cli": "--settings-panel"
    },
    "icons": {
      "description": "Icon library (Font Awesome CDN or Heroicons built into Phoenix)",
      "isDefault": true,
      "points": [],
      "cli": [
        {
          "name": "Font Awesome",
          "flag": "--font-awesome",
          "isDefault": true
        },
        {
          "name": "Heroicons",
          "flag": "--heroicons"
        }
      ]
    },
    "floating-ui": {
      "description": "Floating UI for tooltips and popovers",
      "isRequired": true,
      "points": [
        "floating-ui-cdn"
      ]
    }
  },
  "pageTypes": {
    "dashboard": {
      "file": "pages/dashboard_live.ex",
      "description": "Dashboard with stats and KPI cards",
      "route": "lib/__APP_ID_SNAKE___web/live/dashboard_live.ex",
      "icon": "fa-solid fa-gauge",
      "defaultLabel": "Dashboard"
    },
    "list": {
      "file": "pages/list_live.ex",
      "description": "Data table with pagination",
      "route": "lib/__APP_ID_SNAKE___web/live/__PAGE_ENTITY___live.ex",
      "icon": "fa-solid fa-list",
      "defaultLabel": "Items"
    },
    "detail": {
      "file": "pages/detail_live.ex",
      "description": "Single record detail view (no sidebar entry — accessed via list)",
      "route": "lib/__APP_ID_SNAKE___web/live/__PAGE_ENTITY___detail_live.ex",
      "defaultLabel": "Detail",
      "sidebar": false
    },
    "form": {
      "file": "pages/form_live.ex",
      "description": "Create/edit form",
      "route": "lib/__APP_ID_SNAKE___web/live/__PAGE_ENTITY___form_live.ex",
      "icon": "fa-solid fa-pen-to-square",
      "defaultLabel": "Form"
    },
    "master-detail": {
      "file": "pages/master_detail_live.ex",
      "description": "List + detail side-by-side",
      "route": "lib/__APP_ID_SNAKE___web/live/__PAGE_ENTITY___live.ex",
      "icon": "fa-solid fa-table-columns",
      "defaultLabel": "Items"
    }
  },
  "steps": [
    {
      "action": "call",
      "op": "addDependency",
      "args": [
        "keen_pure_admin",
        "~> 1.3"
      ]
    },
    {
      "action": "call",
      "op": "addStaticPath",
      "args": [
        "themes"
      ]
    },
    {
      "action": "patch",
      "path": "lib/__APP_ID_SNAKE___web.ex",
      "find": "import __APP_MODULE__Web.CoreComponents",
      "replace": "# Core UI components — PureAdmin replaces Phoenix CoreComponents\n      use PureAdmin.Components"
    },
    {
      "action": "patch",
      "path": "config/config.exs",
      "find": "url: [host: \"localhost\"]",
      "replace": "url: [host: \"localhost\", port: 4000]"
    },
    {
      "action": "patch",
      "path": "lib/__APP_ID_SNAKE___web/router.ex",
      "find": "plug :put_root_layout, html: {__APP_MODULE__Web.Layouts, :root}",
      "replace": "plug :put_root_layout, html: {__APP_MODULE__Web.Layouts, :root}\n    plug :put_layout, html: {__APP_MODULE__Web.Layouts, :app}\n    plug __APP_MODULE__Web.Nav"
    },
    {
      "action": "patch",
      "path": "lib/__APP_ID_SNAKE___web/router.ex",
      "find": "get \"/\", PageController, :home",
      "replace": "get \"/\", PageController, :home\n    live \"/getting-started\", GettingStartedLive\n    live \"/users\", UsersLive\n    live \"/settings\", SettingsLive"
    },
    {
      "action": "patch",
      "path": "lib/__APP_ID_SNAKE___web.ex",
      "find": "      use Phoenix.LiveView\n\n      unquote(html_helpers())",
      "replace": "      use Phoenix.LiveView,\n        layout: {__APP_MODULE__Web.Layouts, :app}\n\n      unquote(html_helpers())"
    },
    {
      "action": "patch",
      "path": "assets/js/app.js",
      "find": "import {hooks as colocatedHooks} from \"phoenix-colocated/__APP_ID_SNAKE__\"",
      "replace": "import {hooks as colocatedHooks} from \"phoenix-colocated/__APP_ID_SNAKE__\"\nimport {PureAdminHooks} from \"keen_pure_admin\""
    },
    {
      "action": "patch",
      "path": "assets/js/app.js",
      "find": "hooks: {...colocatedHooks}",
      "replace": "hooks: {...colocatedHooks, ...PureAdminHooks}"
    },
    {
      "action": "delete",
      "path": "lib/__APP_ID_SNAKE___web/components/core_components.ex"
    },
    {
      "action": "delete",
      "path": "priv/static/assets/default.css"
    },
    {
      "action": "delete",
      "path": "lib/__APP_ID_SNAKE___web/live/users_live.ex",
      "unless": "demo-pages"
    },
    {
      "action": "delete",
      "path": "lib/__APP_ID_SNAKE___web/live/settings_live.ex",
      "unless": "demo-pages"
    },
    {
      "action": "patch",
      "path": "lib/__APP_ID_SNAKE___web/router.ex",
      "find": "live \"/getting-started\", GettingStartedLive\n    live \"/users\", UsersLive\n    live \"/settings\", SettingsLive",
      "replace": "live \"/getting-started\", GettingStartedLive",
      "unless": "demo-pages"
    },
    {
      "action": "call",
      "op": "setPureAdminConfig",
      "args": [
        {
          "app_name": "__APP_NAME__",
          "app_version": "0.1.0",
          "copyright": "__COPYRIGHT__",
          "font_class": "pa-font-responsive"
        }
      ]
    },
    {
      "action": "patch",
      "path": "config/config.exs",
      "find": "import_config \"#{config_env()}.exs\"",
      "replace": "# keen_pure_admin translation hook — routes the library's pureAdmin.* keys\n# through Gettext under the \"pure_admin\" domain. Returns nil to fall through\n# to English defaults. See lib/__APP_ID_SNAKE___web/translations.ex for details.\nconfig :keen_pure_admin,\n  translate: &__APP_MODULE__Web.Translations.translate/2\n\nimport_config \"#{config_env()}.exs\"\n\n# Local overrides — gitignored. Create config/.local.exs to override\n# DB credentials, port, or any other dev-only setting.\nFile.regular?(\"config/.local.exs\") && import_config(\".local.exs\")"
    },
    {
      "action": "patch",
      "path": "config/runtime.exs",
      "find": "config :__APP_ID_SNAKE__, __APP_MODULE__Web.Endpoint,\n  http: [port: String.to_integer(System.get_env(\"PORT\", \"4000\"))]",
      "replace": "# PORT env var overrides the port set in dev.exs/.local.exs (set it for prod or\n# containerized dev). Without PORT, dev.exs / config/.local.exs wins.\nif port = System.get_env(\"PORT\") do\n  config :__APP_ID_SNAKE__, __APP_MODULE__Web.Endpoint,\n    http: [port: String.to_integer(port)]\nend"
    },
    {
      "action": "patch",
      "path": ".gitignore",
      "find": "# The directory Mix downloads your dependencies sources to.",
      "replace": "# Local Phoenix config override (DB credentials, custom port, etc.)\nconfig/.local.exs\n\n# The directory Mix downloads your dependencies sources to."
    },
    {
      "action": "delete",
      "path": "lib/__APP_ID_SNAKE__/form_cache.ex",
      "unless": "form-demo"
    },
    {
      "action": "delete",
      "path": "lib/__APP_ID_SNAKE__/form_cache/sweeper.ex",
      "unless": "form-demo"
    },
    {
      "action": "delete",
      "path": "lib/__APP_ID_SNAKE___web/session_plug.ex",
      "unless": "form-demo"
    },
    {
      "action": "delete",
      "path": "lib/__APP_ID_SNAKE___web/live/form_demo_live.ex",
      "unless": "form-demo"
    },
    {
      "action": "patch",
      "path": "lib/__APP_ID_SNAKE__/application.ex",
      "find": "{Phoenix.PubSub, name: __APP_MODULE__.PubSub},",
      "replace": "{Phoenix.PubSub, name: __APP_MODULE__.PubSub},\n      __APP_MODULE__.FormCache.Sweeper,",
      "if": "form-demo"
    },
    {
      "action": "patch",
      "path": "lib/__APP_ID_SNAKE___web/router.ex",
      "find": "plug :put_secure_browser_headers",
      "replace": "plug :put_secure_browser_headers\n    plug __APP_MODULE__Web.SessionPlug",
      "if": "form-demo"
    },
    {
      "action": "patch",
      "path": "lib/__APP_ID_SNAKE___web/router.ex",
      "find": "live \"/getting-started\", GettingStartedLive",
      "replace": "live \"/getting-started\", GettingStartedLive\n    live \"/form-demo\", FormDemoLive",
      "if": "form-demo"
    }
  ],
  "instructions": [
    "cd __APP_ID__",
    "# Optional: create config/.local.exs (gitignored) for personal dev overrides",
    "#   import Config",
    "#   config :__APP_ID_SNAKE__, __APP_MODULE__.Repo, username: \"...\", password: \"...\"",
    "#   config :__APP_ID_SNAKE__, __APP_MODULE__Web.Endpoint, http: [port: 4030]",
    "mix ecto.create  # only if ecto is enabled",
    "mix phx.server",
    "Open http://localhost:4000"
  ],
