      "lib/__APP_ID_SNAKE___web/controllers/page_html/home.html.heex": "sha256:a54457572d0ff00a0f6b226bbdfeb838808f7329c2da56e87b2e14ca32ca97da",
      "lib/__APP_ID_SNAKE___web/nav.ex": "sha256:42c1b8a6f14b592852842f6c3d7b70e95ee50d2e20f160cb93d085bfb0e23a86",
